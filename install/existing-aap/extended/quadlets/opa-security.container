[Unit]
Description=AAC OPA Security (:8181)
After=network-online.target

[Container]
Image=docker.io/openpolicyagent/opa:latest
ContainerName=opa-security
PublishPort=8181:8181
Volume=/etc/opa/security:/policies:ro,z
Exec=run --server --addr :8181 /policies

[Service]
Restart=always

[Install]
WantedBy=default.target
