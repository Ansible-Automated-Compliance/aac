Description=AAC PostgreSQL (:5432)
After=network-online.target

[Container]
Image=registry.redhat.io/rhel9/postgresql-15:latest
ContainerName=aac-postgresql
PublishPort=5432:5432
Environment=POSTGRESQL_USER=compliance
Environment=POSTGRESQL_DATABASE=compliance
Secret=compliance_db_password,type=env,target=POSTGRESQL_PASSWORD
Volume=compliance_pgdata:/var/lib/pgsql/data

[Service]
Restart=always

[Install]
WantedBy=default.target