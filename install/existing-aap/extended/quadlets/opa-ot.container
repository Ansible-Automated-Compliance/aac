[Unit]
Description=AAC OPA OT (:8183)
After=network-online.target

[Container]
Image=docker.io/openpolicyagent/opa:latest
ContainerName=opa-ot
PublishPort=8183:8181
Volume=/etc/opa/ot:/policies:ro,z
Exec=run --server --addr :8181 /policies

[Service]
Restart=always

[Install]
WantedBy=default.target