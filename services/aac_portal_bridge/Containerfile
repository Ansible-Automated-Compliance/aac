# AAC Portal Bridge — read-only inventory catalog API
# Build on the amd64 build host, not on Mac/aarch64.
#   podman build -t quay.io/rh-ee-tcoulter/aac-portal-bridge:v1.0.0 .
FROM registry.access.redhat.com/ubi9/python-311

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py .

EXPOSE 8005
# PG_* and AAC_BRIDGE_TOKEN(S) supplied at runtime via env / OCP secret.
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8005"]
