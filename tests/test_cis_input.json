{
  "os_family": "RedHat",
  "distribution": "CentOS", 
  "distribution_version": "9.0",
  "selinux_status": "enforcing",
  "firewall_enabled": true,
  "ssh_port": 22,
  "loaded_modules": ["ext4", "xfs", "btrfs"],
  "mounts": {
    "/tmp": {
      "device": "/dev/sda2",
      "fstype": "ext4", 
      "options": ["rw", "nodev", "nosuid", "noexec"]
    }
  },
  "net_ipv4_ip_forward": 0,
  "ssh_config": [
    "Protocol 2",
    "PermitRootLogin no", 
    "MaxAuthTries 4"
  ]
}