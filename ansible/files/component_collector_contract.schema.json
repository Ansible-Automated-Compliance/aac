{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "component_collector_contract",
  "title": "AAC component collector contract",
  "description": "Machine-checked form of docs/reference/COMPONENT_COLLECTOR_CONTRACT.md. scripts/layered_collection.py checks every catalog entry against $defs.catalog_layering, builds every collector input to $defs.target and checks every collector result against $defs.result, in tests and at run time.",
  "contract_version": "1",
  "$defs": {
    "catalog_layering": {
      "description": "Fields a detection catalog entry may add for layered collection. All optional.",
      "type": "object",
      "properties": {
        "assess": {"type": "boolean"},
        "contains": {
          "type": "array", "maxItems": 100,
          "items": {"type": "string", "pattern": "^(\\*|[a-z][a-z0-9_]*)$"}
        },
        "collectors": {
          "type": "array", "maxItems": 2,
          "items": {"$ref": "#/$defs/catalog_collector"}
        }
      }
    },
    "catalog_collector": {
      "type": "object",
      "required": ["layer", "file", "cost", "access"],
      "additionalProperties": false,
      "properties": {
        "layer": {"enum": ["host", "service"]},
        "file": {"type": "string", "pattern": "^(none yet|[a-z][a-z0-9_]*_(host|service)\\.py)$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "cost": {"enum": ["cheap", "heavy"]},
        "access": {"type": "string", "minLength": 20, "maxLength": 600},
        "credential": {
          "type": "object",
          "required": ["type", "env"],
          "additionalProperties": false,
          "properties": {
            "type": {"type": "string", "minLength": 3, "maxLength": 100},
            "env": {
              "type": "array", "minItems": 1, "maxItems": 10,
              "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
            }
          }
        }
      }
    },
    "target": {
      "description": "What a collector receives, as the Python value `target`. It reaches the host as one base64 value, never as Ansible variables.",
      "type": "object",
      "required": ["contract_version", "component_key", "layer", "layer_number", "instance_id", "parent",
                   "host", "reached_through", "depth", "max_depth", "credential_type", "credential_env",
                   "locator", "max_facts_bytes", "collector", "guard"],
      "additionalProperties": false,
      "properties": {
        "contract_version": {"const": "1"},
        "component_key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "layer": {"enum": ["host", "service"]},
        "layer_number": {"enum": [2, 3]},
        "instance_id": {"type": "string", "minLength": 1, "maxLength": 600},
        "parent": {
          "type": "object",
          "required": ["kind", "id"],
          "additionalProperties": false,
          "properties": {"kind": {"enum": ["host", "instance"]}, "id": {"type": "string", "minLength": 1, "maxLength": 600}}
        },
        "host": {"type": "string", "maxLength": 255},
        "reached_through": {"type": "array", "maxItems": 500, "items": {"type": "string", "maxLength": 255}},
        "depth": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_depth": {"type": "integer", "minimum": 1, "maximum": 5},
        "credential_type": {"type": "string", "maxLength": 100},
        "credential_env": {"type": "array", "maxItems": 10, "items": {"type": "string"}},
        "locator": {"type": "object"},
        "max_facts_bytes": {"type": "integer", "minimum": 1024},
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "binary_dirs": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^/[A-Za-z0-9._*/-]+$"}},
            "runtime_parents": {"type": "array", "maxItems": 50, "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,15}$|^[A-Za-z0-9._-]{16,40}$"}}
          }
        },
        "collector": {
          "type": "object",
          "required": ["file", "version", "cost"],
          "additionalProperties": false,
          "properties": {"file": {"type": "string"}, "version": {"type": "string"}, "cost": {"enum": ["cheap", "heavy"]}}
        }
      }
    },
    "result": {
      "description": "What a collector returns through g.collected() or g.not_collected(). The guard prints it as one base64 line; it is decoded only by scripts/layered_collection.py.",
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["collected", "not_collected"]},
        "reason": {"type": "string", "maxLength": 300},
        "instance": {
          "type": "object",
          "required": ["identity"],
          "additionalProperties": false,
          "properties": {
            "identity": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,199}$"},
            "name": {"type": "string", "maxLength": 200}
          }
        },
        "facts": {"type": "object"},
        "children": {
          "type": "array", "maxItems": 2000,
          "items": {
            "type": "object",
            "required": ["kind", "value"],
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["package", "service", "process", "container_image"]},
              "value": {"type": "string", "minLength": 1, "maxLength": 300},
              "name": {"type": "string", "maxLength": 200},
              "detail": {"type": "object"}
            }
          }
        },
        "notes": {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 300}}
      }
    }
  }
}
