# =============================================================================
# vault_secrets.rhpds.<cluster-short-name>.yml.example
#
# SCHEMA TEMPLATE for per-cluster RHPDS vault files.
#
# One file per RHPDS cluster. File name encodes the cluster short name so
# multiple clusters can coexist without overwriting each other:
#
#   vault_secrets.rhpds.mvt2r1.yml      (cluster-mvt2r-1)
#   vault_secrets.rhpds.h2cq41.yml      (cluster-h2cq4-1)
#   vault_secrets.rhpds.jp6ng1.yml      (cluster-jp6ng-1)
#
# Lifecycle:
#   CREATE   — Node 1 of "AAC - Full RHPDS Provisioning" workflow (the
#              chained credential rotation step) writes this file on both
#              Mac and lab AAP from the workflow survey + Node 1's set_stats.
#   USE      — Playbooks include this file via include_vars when the variable
#              `rhpds_cluster_short_name` is set; values override anything in
#              vault_secrets.yml for the duration of the cluster's life.
#   DESTROY  — "AAC - Decommission RHPDS Cluster" workflow (Phase D) removes
#              this file from Mac + lab AAP when the cluster is torn down.
#
# Scope:  This specific RHPDS cluster ONLY. NEVER use across clusters; the
#         AWS account, AAP gateway URL, and OCP bearer token all rotate per
#         cluster.
#
# Gitignored by the existing `ansible/vars/vault_secrets.*.yml` line in
# .gitignore. This `.example` is committed (the `*.example` negation lets it
# through).
# =============================================================================

---

# ── Cluster identity ────────────────────────────────────────────────────────
rhpds_cluster:               cluster-<short>-1.dynamic2.redhatworkshops.io
rhpds_cluster_short_name:    <short>1   # used as the file-name suffix

# ── RHPDS AAP credentials (from RHPDS email section 1) ──────────────────────
rhpds_gateway_password:      <AAP gateway admin password — typically same as controller>
rhpds_controller_password:   <AAP controller admin password>

# ── RHPDS AWS provisioning credentials (from RHPDS email section 2) ─────────
aws_rhpds_access_key:        <AKIA...>
aws_rhpds_secret_key:        <40-char AWS secret>
aws_rhpds_account_id:        <12-digit RHPDS-leased AWS account id>
aws_rhpds_account_name:      "RHPDS cluster-<short>-1"
aws_rhpds_iam_user:          open-environment-<short>-admin

# ── RHPDS OpenShift cluster (from RHPDS email sections 4 + 5) ───────────────
vault_ocp_login_token:       sha256~<OCP API bearer token>
# vault_ocp_kubeadmin_password: <kubeadmin password — optional, only for UI logins>

# ── RHPDS AAP MCP integration ───────────────────────────────────────────────
vault_aap_ocp_mcp_token:     <MCP bearer token for the RHPDS AAP gateway>

# ── EC2 demo host (populated by Node 1 set_stats after provisioning) ────────
rhpds_demo_host_ip:          <e.g. 3.222.213.178>
ec2_private_key: |
  <PEM-encoded RSA private key for ec2-user — block-scalar with key delimiters>
  <generated by Node 1 of the provisioning workflow>
  <required for any SSH back to the demo host>
  <retrieve from job 6224-style artifacts on local AAP if lost>
  # NOTE: replace this block with the actual key as a YAML block scalar
  # so it preserves whitespace; literal BEGIN/END markers must be present
  # in the real file.
