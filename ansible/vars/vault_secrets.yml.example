---
# AAC vault_secrets.yml — site-specific credentials
#
# SETUP: Copy this file to vault_secrets.yml and fill in your values.
#   cp ansible/vars/vault_secrets.yml.example ansible/vars/vault_secrets.yml
#
# vault_secrets.yml is gitignored — your credentials stay local.
# NEVER commit vault_secrets.yml with real credentials to git.
#
# ─────────────────────────────────────────────────────────────────────────────
# CATEGORY 1 — MUST PROVIDE (personal credentials — unique per installer)
# ─────────────────────────────────────────────────────────────────────────────

# Red Hat subscription — for pulling RHEL content and EE builds
vault_redhat_username: PLACEHOLDER         # Your RH account email (e.g. user@example.com)
vault_redhat_offline_token: PLACEHOLDER    # https://access.redhat.com/management/api → Generate Token

# GitHub Personal Access Token — for AAP to sync the compliance repo
# Scopes: repo (read), workflow
vault_github_pat: PLACEHOLDER              # https://github.com/settings/tokens → Generate new token

# Container registry — only needed if building a custom EE image
vault_quay_username: PLACEHOLDER           # quay.io username (leave as PLACEHOLDER if not building EE)
vault_quay_password: PLACEHOLDER           # quay.io password or robot token

# Anthropic API key — only needed if running mac-aap with AAP 2.7's
# ALIA (Ansible Lightspeed Intelligent Assistant) backed by Claude.
# Get one at https://console.anthropic.com/settings/keys with a
# monthly spend cap. Stored in k8s Secret `chatbot-configuration-secret`
# in `aap-operator` namespace as the chatbot_token field.
vault_anthropic_api_key: PLACEHOLDER       # sk-ant-api03-...

# ─────────────────────────────────────────────────────────────────────────────
# CATEGORY 2 — LOCAL LAB / PERMANENT INSTALL AWS CREDENTIALS
# Used by: local compliance lab provisioning, Sentinel TF demo, Terraform Enforce
# Source: Your personal AWS account or enterprise AWS account
# ─────────────────────────────────────────────────────────────────────────────

aws_lab_access_key: PLACEHOLDER            # IAM user access key for lab work
aws_lab_secret_key: PLACEHOLDER            # IAM user secret key for lab work
aws_local_account_id: PLACEHOLDER          # 12-digit AWS account ID (e.g. 123456789012)
aws_local_account_name: PLACEHOLDER        # Friendly name (e.g. "My Lab Account")
aws_local_iam_user: PLACEHOLDER            # IAM username (e.g. aac-lab-user)

# ─────────────────────────────────────────────────────────────────────────────
# CATEGORY 3 — RHPDS AWS CREDENTIALS (update with each new RHPDS cluster)
# Used by: RHPDS provisioning workflow (EC2 demo host, EventBridge auto-stop)
# Source: RHPDS cluster allocation email — new credentials each provisioning
# Update via: "AAC - Update RHPDS AWS Credentials" AAP job template
# ─────────────────────────────────────────────────────────────────────────────

aws_rhpds_access_key: PLACEHOLDER          # RHPDS-allocated AWS access key
aws_rhpds_secret_key: PLACEHOLDER          # RHPDS-allocated AWS secret key
aws_rhpds_account_id: PLACEHOLDER          # RHPDS AWS account ID
aws_rhpds_account_name: PLACEHOLDER        # e.g. "RHPDS cluster-abc123-1"
aws_rhpds_iam_user: PLACEHOLDER            # e.g. open-environment-abc123-admin

# ─────────────────────────────────────────────────────────────────────────────
# CATEGORY 4 — MUST SET (site-specific — no universal default)
# ─────────────────────────────────────────────────────────────────────────────

# AAP passwords — set during AAP installation
vault_aap_admin_password: PLACEHOLDER      # AAP admin UI password (NOT the vault password)
vault_windows_admin_password: PLACEHOLDER  # Windows EC2 Administrator password for lab

# AAP MCP bearer token — created by "AAC - Rotate MCP Token" template after install
vault_aap_local_mcp_token: PLACEHOLDER     # Run template ID 40 to generate; update here after rotation
vault_aap_mac_mcp_token: PLACEHOLDER       # mac-aap (CRC) gateway bearer token; required for install/mac-aap/playbooks/seed_lab10_macaap.yml

# ─────────────────────────────────────────────────────────────────────────────
# CATEGORY 5 — CAN USE DEFAULTS (change if needed for your site)
# ─────────────────────────────────────────────────────────────────────────────

compliance_db_password: compliance         # PostgreSQL compliance DB password
compliance_reader_password: compliance     # PostgreSQL read-only user password
compliance_writer_password: compliance     # PostgreSQL evidence writer (INSERT+SELECT only) — enables aac_evidence_writer_user
grafana_admin_password: PLACEHOLDER        # Grafana admin password

# ─────────────────────────────────────────────────────────────────────────────
# CATEGORY 6 — CAA (Certifiable Audit Artifact) cosign signing
# ─────────────────────────────────────────────────────────────────────────────
# Private key used to sign every compliance_certifications row. Generated once
# with `COSIGN_PASSWORD="" cosign generate-key-pair`; the matching public key is
# committed to docs/security/caa-signing-key-v1.pub for auditor verification.
#
# When empty, aac_store_certification falls back to the pre-cosign
# "sha256-unsigned" placeholder and the CAA is provenance-only (not
# cryptographically verifiable). Populate this to enable real signing.
#
# Store the full PEM (including the -BEGIN...KEY- / -END...KEY- markers cosign
# emits) as a multi-line YAML block scalar (the |- form preserves newlines
# within the key body). Example placeholder — replace with your real key:
caa_signing_private_key: "PLACEHOLDER_paste_cosign_private_pem_here_as_YAML_block_scalar"
caa_signing_password: ""                   # empty for the automation default

# ─── AAC Customer Portal — tenant token (patch intelligence pipe) ────────────
# Used by pull_patch_worklist.yml to pull GET /portal/v1/tenants/{id}/patches.
# Issue it in the Portal for this tenant with the 'remediation' scope; it is
# bcrypt-hashed at rest there and is rotatable without downtime. Pair it with
# portal_base_url + portal_tenant_id in ansible/vars/site_config.yml.
vault_portal_tenant_token: PLACEHOLDER
