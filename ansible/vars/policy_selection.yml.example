---
# policy_selection.yml — pick the frameworks the OPA loader loads.
#
# Copy to ansible/vars/policy_selection.yml (gitignored, yours to edit),
# set unwanted frameworks to false, and run the loader with source=file:
#   "AAC - Load OPA Policies" with extra_vars: {source: file}
#
# Rules the loader enforces:
#   - every key here must be a real loader key (typos fail the run)
#   - deselected frameworks are LISTED in the job output, never silently dropped
#   - deselecting does not unload policies already in a running OPA —
#     redeploy the OPA containers (or run a database-mode reconcile) to prune
#
# This example lists every loadable framework, all enabled — identical to
# source=all. Regenerate: python3 scripts/gen_policy_selection_example.py

policy_selection:
  # ── opa-security ──────────────────────────────────────────────
  # CIS AKS — CIS AKS benchmark (CIS).
  cis_aks: true
