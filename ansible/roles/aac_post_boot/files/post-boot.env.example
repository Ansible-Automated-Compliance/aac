# AAC post-boot recovery configuration
# Copy to ~/.config/aac/post-boot.env on the lab host. NOT in git — holds credentials.
AAP_URL=https://<aap-gateway-route>
OPA_COMPLIANCE_URL=http://<opa-compliance-route>
AAP_USER=admin
AAP_PASS=<aap-admin-password>

# Start CRC if the VM is not Running. Set false to refresh only.
START_CRC=true

# How long to wait for the controller before giving up.
AAP_WAIT_SECONDS=1800

# Job templates launched to refresh the dashboards, in order.
REFRESH_TEMPLATES=212,214,10
